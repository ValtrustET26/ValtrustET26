generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Valuation {
  id                      Int      @id @default(autoincrement())
  publicId                String      @unique @default(uuid())
  department              String
  municipality            String
  zone                    String
  exactAddress            String?
  postalCode              Int?
  type                    String
  condition               String
  areaM2                  Float
  landAreaM2              Float?
  levels                  Int
  yearBuilt               Int
  bedrooms                Int
  bathrooms               Int
  parkingSpaces           Int?
  kitchenType             String
  hasLivingDiningRoom     Boolean?
  hasLaundryRoom          Boolean?
  hasStorageCellar        Boolean?
  hasStudioHomeOffice     Boolean?
  hasServiceQuarter       Boolean?
  hasAC                   Boolean?
  hasSmartHome            Boolean?
  hasPool                 Boolean?
  hasSecurityGate         Boolean?
  hasCCTV                 Boolean?
  hasGym                  Boolean?
  hasElevator             Boolean?
  hasGreenAreas           Boolean?
  hasOtherAmenity         Boolean?
  otherAmenityDescription String?
  publicDescription       String?
  maintenanceFee          Float?
  petsAllowed             String?
  includedServices        String?
  estimatedMin            Float
  estimatedMax            Float
  estimatedValue          Float
  pricePerM2              Float
  createdAt               DateTime @default(now())
}

model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  passwordHash     String
  role             Role
  createdAt        DateTime       @default(now())
  favorites        Favorite[]
  receivedMessages Message[]      @relation("ReceivedMessages")
  sentMessages     Message[]      @relation("SentMessages")
  notifications    Notification[]
  properties       Property[]
  verifications    Verification[]
}

model Property {
  id           String          @id @default(uuid())
  userId       String
  title        String
  location     String
  areaM2       Float
  rooms        Int
  bathrooms    Int
  price        Decimal
  isVerified   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  favorites    Favorite[]
  messages     Message[]
  user         User            @relation(fields: [userId], references: [id])
  photos       PropertyPhoto[]
  verification Verification?
}

model PropertyPhoto {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  order      Int
  property   Property @relation(fields: [propertyId], references: [id])
}

model Verification {
  id         String             @id @default(uuid())
  propertyId String             @unique
  adminId    String
  status     VerificationStatus @default(pending)
  notes      String?
  verifiedAt DateTime?
  admin      User               @relation(fields: [adminId], references: [id])
  property   Property           @relation(fields: [propertyId], references: [id])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  propertyId String
  content    String
  sentAt     DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  savedAt    DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, propertyId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  buyer
  seller
  admin
}

enum VerificationStatus {
  pending
  approved
  rejected
}
