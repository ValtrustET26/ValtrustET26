generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Valuation {
  id             Int      @id @default(autoincrement())

  // Lo que ingresó el usuario
  department     String
  municipality   String
  zone           String
  type           String
  areaM2         Float
  landAreaM2     Float?
  bedrooms       Int
  bathrooms      Int
  parking        Int
  condition      String
  hasPool        Boolean
  hasSecurity    Boolean
  hasGarden      Boolean
  hasAC          Boolean

  // Lo que calculó la app
  estimatedMin   Float
  estimatedMax   Float
  estimatedValue Float
  pricePerM2     Float

  createdAt      DateTime @default(now())
}