generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Valuation system (DEMO)

model Valuation {
  id                      Int      @id @default(autoincrement())

  // Location
  department              String
  municipality            String
  zone                    String
  exactAddress            String?
  postalCode              String?

  // Property Details
  type                    String
  condition               String
  areaM2                  Float
  landAreaM2              Float?
  levels                  Int
  yearBuilt               Int

  // Rooms & Spaces
  bedrooms                Int
  bathrooms               Int
  parkingSpaces           Int
  kitchenType             String
  hasLivingDiningRoom     Boolean
  hasLaundryRoom          Boolean
  hasStorageCellar        Boolean
  hasStudioHomeOffice     Boolean
  hasServiceQuarter       Boolean

  // Condition / Extras
  hasAC                   Boolean
  hasSmartHome            Boolean
  hasPool                 Boolean

  // Security & Amenities
  hasSecurityGate         Boolean
  hasCCTV                 Boolean
  hasGym                  Boolean
  hasElevator             Boolean
  hasGreenAreas           Boolean
  hasOtherAmenity         Boolean
  otherAmenityDescription String?

  // Additional Information
  publicDescription       String?
  maintenanceFee          Float?
  petsAllowed             String
  includedServices        String?

  // Result
  estimatedMin            Float
  estimatedMax            Float
  estimatedValue          Float
  pricePerM2              Float

  createdAt               DateTime @default(now())
}

// General tables

enum Role {
  buyer
  seller
  admin
}

enum VerificationStatus {
  pending
  approved
  rejected
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role
  createdAt    DateTime       @default(now())
 
  properties    Property[]
  sentMessages  Message[]      @relation("SentMessages")
  receivedMessages Message[]   @relation("ReceivedMessages")
  favorites     Favorite[]
  notifications Notification[]
  verifications Verification[]
}

model Property {
  id         String       @id @default(uuid())
  userId     String
  title      String
  location   String
  areaM2     Float
  rooms      Int
  bathrooms  Int
  price      Decimal
  isVerified Boolean      @default(false)
  createdAt  DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id])
  photos      PropertyPhoto[]
  verification Verification?
  messages    Message[]
  favorites   Favorite[]
}

model PropertyPhoto {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  order      Int

  property   Property @relation(fields: [propertyId], references: [id])
}

model Verification {
  id         String             @id @default(uuid())
  propertyId String             @unique
  adminId    String
  status     VerificationStatus @default(pending)
  notes      String?
  verifiedAt DateTime?

  property   Property @relation(fields: [propertyId], references: [id])
  admin      User     @relation(fields: [adminId], references: [id])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  propertyId String
  content    String
  sentAt     DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  savedAt    DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}